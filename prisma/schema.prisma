generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Event {
  id            Int      @id @default(autoincrement())
  name          String   @db.VarChar(200)
  room_width_m  Float    @default(15)
  room_height_m Float    @default(10)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  guests    Guest[]
  hosts     Host[]
  groups    GuestGroup[]
  tables    Table[]
  relations GuestRelation[]
}

model Guest {
  id                Int                @id @default(autoincrement())
  event_id          Int
  event             Event              @relation(fields: [event_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  full_name         String             @db.VarChar(100)
  guest_type        GuestType
  main_guest_id     Int?
  main_guest        Guest?             @relation("MainGuest", fields: [main_guest_id], references: [id], onUpdate: NoAction)
  host_name         String?            @db.VarChar(100)
  host_id           Int?
  host              Host?              @relation(fields: [host_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  gender            Gender
  age_range         AgeRange           @default(ADULT)
  avatar_key        String?            @db.VarChar(50)
  notes             String?
  status            Status             @default(INVITED)
  table_assignments TableAssignment[]
  group_members     GuestGroupMember[]
  other_guests      Guest[]            @relation("MainGuest")
  relations_as_a    GuestRelation[]    @relation("GuestRelationA")
  relations_as_b    GuestRelation[]    @relation("GuestRelationB")

  @@index([event_id])
}

model GuestGroup {
  id        Int                @id @default(autoincrement())
  event_id  Int
  event     Event              @relation(fields: [event_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  name      String             @db.VarChar(100)
  category  String?            @db.VarChar(50)
  members   GuestGroupMember[]

  @@index([event_id])
}

model GuestGroupMember {
  id       Int        @id @default(autoincrement())
  guest    Guest      @relation(fields: [guest_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  guest_id Int
  group    GuestGroup @relation(fields: [group_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  group_id Int
}

model GuestRelation {
  id         Int                 @id @default(autoincrement())
  event_id   Int
  event      Event               @relation(fields: [event_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  guest_a_id Int
  guest_b_id Int
  guest_a    Guest               @relation("GuestRelationA", fields: [guest_a_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  guest_b    Guest               @relation("GuestRelationB", fields: [guest_b_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  kind       GuestRelationKind
  strength   Int                 @default(3)
  source     GuestRelationSource @default(USER)
  notes      String?             @db.VarChar(500)

  @@unique([guest_a_id, guest_b_id, kind])
  @@index([event_id])
}

model Table {
  id          Int               @id @default(autoincrement())
  event_id    Int
  event       Event             @relation(fields: [event_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  name        String            @db.VarChar(50)
  shape       Shape             @default(redonda)
  seats       Int
  min_seats   Int?
  category    String?           @db.VarChar(50)
  pos_x       Float?
  pos_y       Float?
  width       Float             @default(1.5)
  height      Float             @default(1.5)
  assignments TableAssignment[]

  @@index([event_id])
}

model TableAssignment {
  id          Int     @id @default(autoincrement())
  table       Table   @relation(fields: [table_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  table_id    Int
  guest       Guest   @relation(fields: [guest_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  guest_id    Int
  seat_number Int?
  locked      Boolean @default(false)

  @@unique([guest_id])
}

enum GuestType {
  MAIN_GUEST
  PLUS_ONE
}

enum Gender {
  FEMALE
  MALE
}

enum AgeRange {
  ADULT
  CHILD
  BABY
}

enum Status {
  INVITED
  CONFIRMED
  DECLINED
}

enum Shape {
  redonda
  rectangular
}

enum GuestRelationKind {
  AFFINITY
  FAMILY
  SOCIAL
  CONFLICT
}

enum GuestRelationSource {
  USER
  IMPORT
  AI_SUGGESTION
}

model Host {
  id         Int      @id @default(autoincrement())
  event_id   Int
  event      Event    @relation(fields: [event_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  name       String   @db.VarChar(100)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  guests Guest[]

  @@unique([event_id, name])
  @@index([event_id])
}
